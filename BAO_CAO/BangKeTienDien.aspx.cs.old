                                    sh5 = sh5 + double.Parse(muc[4]);
                                    newRowTong[15] = muc[5];
                                    sh6 = sh6 + double.Parse(muc[5]);

                                }

                            }
                            else
                            {
                               
                                dn = HH - sumDN;
                                if (dtbtemp.Rows[0]["loai_bg"].ToString().Trim() == "MDK")
                                {
                                    if (dtbtemp.Rows[0]["ten_viet_tat"].ToString() == "NT")
                                    {
                                        newRowTong[16] = dn;
