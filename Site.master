                <!--
                <li class="nav-item" data-toggle="tooltip" data-placement="right" title="Báo cáo ngày">
                    <a class="nav-link" href="./CapNhatModuleOLT.aspx">
                        <i class="fa fa-fw fa-wrench"></i>
                        <span class="nav-link-text">Báo cáo ngày</span>
                    </a>
                </li>
                -->
            </ul>
            <ul class="navbar-nav sidenav-toggler">
                <li class="nav-item">
                    <a class="nav-link text-center" id="sidenavToggler">
                        <i class="fa fa-fw fa-angle-left"></i>
                    </a>
                </li>
            </ul>
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link">Xin chào
                        <asp:Label ID="txtUser" runat="server"></asp:Label>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-toggle="modal" data-target="#logoutModal">
                        <i class="fa fa-fw fa-sign-out"></i>Đăng xuất</a>
                </li>
            </ul>
        </div>
    </nav>
    <div class="content-wrapper">
        <div class="container-fluid">
            <!-- Breadcrumbs-->
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item">
                    <a href="Default.aspx">Trang chủ</a>
                </li>
                <li class="breadcrumb-item active"><%: Page.Title %></li>
            </ol>
            <form runat="server" id="main">
                <asp:ContentPlaceHolder runat="server" ID="FeaturedContent" />
                <asp:ContentPlaceHolder runat="server" ID="MainContent" />
            </form>
        </div>
        <!-- /.container-fluid-->
        <!-- /.content-wrapper-->
        <footer class="sticky-footer">
            <div class="container">
                <div class="text-center">
                    <small>Phần mềm quản lý hóa đơn điện ,Hỗ trợ: 02103.636668</small>
                    <br />
                    <small style="color: white">Copyright &copy; VNPT Phú Thọ <%: DateTime.Now.Year %></small>
                </div>
            </div>
        </footer>
        <!-- Scroll to Top Button-->
        <a class="scroll-to-top rounded" href="#page-top">
            <i class="fa fa-angle-up"></i>
        </a>
        <!-- Logout Modal-->
        <div class="modal fade" id="logoutModal" tabindex="-1" role="dialog" aria-labelledby="logoutModal"
            aria-hidden="true">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLabel">Bạn thật sự muốn đăng xuất?</h5>
                        <button class="close" type="button" data-dismiss="modal" aria-label="Close">
                            <span aria-hidden="true">×</span>
                        </button>
                    </div>
                    <div class="modal-body">Chọn "Đăng xuất" để thoát phiên.</div>
                    <div class="modal-footer">
                        <button class="btn btn-secondary" type="button" data-dismiss="modal">Hủy bỏ</button>
                        <a class="btn btn-primary" href="<%= ResolveUrl("Logout.aspx")%>">Đăng xuất</a>
                    </div>
                </div>
            </div>
        </div>
        <!-- Bootstrap core JavaScript-->
        <%--  <script src="vendor/jquery/jquery.min.js"></script>--%>
        <script src='<%= ResolveUrl("vendor/bootstrap/js/bootstrap.bundle.min.js")%>'></script>
        <script src='<%= ResolveUrl("vendor/jquery-easing/jquery.easing.min.js")%>'></script>
        <script src='<%= ResolveUrl("js/sb-admin.min.js")%>'></script>
        <!-- DatePicker -->
       <%-- <script src="../vendor/datepicker/bootstrap-datepicker.js" type="text/javascript"></script>
        <script src="../vendor/datepicker/locales/bootstrap-datepicker.vi.js" type="text/javascript"></script>--%>
        <!-- bootstrap time picker -->
       <%-- <script src="../vendor/timepicker/bootstrap-timepicker.min.js" type="text/javascript"></script>--%>
    </div>

</body>
</html>
