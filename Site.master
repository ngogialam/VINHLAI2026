            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarResponsive">
            <ul class="navbar-nav navbar-sidenav" id="exampleAccordion">
                <li class="nav-item" data-toggle="tooltip" data-placement="right" title="Trang chủ">
                    <a class="nav-link" href='<%= ResolveUrl("Default.aspx")%>'>
                        <i class="fa fa-fw fa-home" style="font-size: 20px"></i>
                        <span class="nav-link-text" style="font-size: 18px">Trang chủ</span>
                    </a>
                </li>
                <li class="nav-item" data-toggle="tooltip" data-placement="right" title="Bán hàng">
                    <a class="nav-link nav-link-collapse collapsed" data-toggle="collapse" href="#NhapChiSo"
                        data-parent="#exampleAccordion">
                        <i class="fa fa-fw fa-cart-plus" style="font-size: 20px"></i>
                        <span class="nav-link-text" style="font-size: 18px">Nhập chỉ số</span>
                    </a>
                    <ul class="sidenav-second-level collapse" id="NhapChiSo">
                        <li>
                            <a href='<%= ResolveUrl("NhapChiSo.aspx")%>'>Chỉ số công tơ</a>
                        </li>
                        <li>
                            <a href='<%= ResolveUrl("ChiSoCongToTong.aspx")%>'>Chỉ số công tơ tổng</a>
                        </li>
                    </ul>
                </li>
                <li class="nav-item" data-toggle="tooltip" data-placement="right" title="Hóa đơn">
                    <a class="nav-link nav-link-collapse collapsed" data-toggle="collapse" href="#HoaDon"
                        data-parent="#exampleAccordion">
                        <i class="fa fa-fw fa-sticky-note" style="font-size: 20px"></i>
                        <span class="nav-link-text" style="font-size: 18px">Hóa đơn điện tử</span>
                    </a>
                    <ul class="sidenav-second-level collapse" id="HoaDon">
                        <li>
                            <a href='<%= ResolveUrl("LapHoaDon.aspx")%>'>Lập hóa đơn</a>
                        </li>
                        <li>
                            <a href='<%= ResolveUrl("LapHoaDonDienTangGia.aspx")%>'>Lập hóa đơn điện tăng giá</a>
                        </li>
                        <li>
                            <a href='<%= ResolveUrl("PhatHanhHD.aspx")%>'>Phát hành hóa đơn</a>
                        </li>
                        <li>
                            <a href='<%= ResolveUrl("InChuyenDoiHoaDon.aspx")%>'>In chuyển đổi</a>
                        </li>
                        <li>
                            <a href='<%= ResolveUrl("InChuyenDoiTheoSoHD.aspx")%>'>In chuyển đổi theo số hóa đơn</a>
                        </li>
                        <li>
                            <a href='<%= ResolveUrl("DanhSachHoaDon.aspx")%>'>Danh sách HDDT</a>
                        </li>
                         <li>
                            <a href='<%= ResolveUrl("ThayTheHoaDon.aspx")%>'>Lập hóa đơn thay thế</a>
                        </li>
                         <li>
                            <a href='<%= ResolveUrl("HuyHoaDon.aspx")%>'>Hủy hóa đơn</a>
                        </li>

                    </ul>
                </li>

                <li class="nav-item" data-toggle="tooltip" data-placement="right" title="Danh mục">
                    <a class="nav-link nav-link-collapse collapsed" data-toggle="collapse" href="#DanhMuc"
                        data-parent="#exampleAccordion">
                        <i class="fa fa-fw fa-address-book-o" style="font-size: 20px"></i>
                        <span class="nav-link-text" style="font-size: 18px">Danh mục</span>
                    </a>
                    <ul class="sidenav-second-level collapse" id="DanhMuc">
                        <li>
                            <a href='<%= ResolveUrl("DanhMucBangGiaDien.aspx")%>'>Danh mục bảng giá điện </a>
                        </li>
                        <li>
                            <a href='<%= ResolveUrl("DanhMucTramBienAp.aspx")%>'>Danh mục trạm biến áp</a>
                        </li>
                        <li>
                            <a href='<%= ResolveUrl("DanhSachKhachHang.aspx")%>'>Danh mục khách hàng</a>
                        </li>
                        <li>
                            <a href='<%= ResolveUrl("DanhMucNhanVien.aspx")%>'>Danh mục nhân viên</a>
                        </li>
                        <li>
                            <a href='<%= ResolveUrl("DanhMucCongTo.aspx")%>'>Danh mục công tơ</a>
                        </li>
                        <li>
                            <a href='<%= ResolveUrl("DanhMucKhu.aspx")%>'>Danh mục khu</a>
                        </li>
                        <li>
                            <a href='<%= ResolveUrl("DanhSachKyHD.aspx")%>'>Kỳ hóa đơn</a>
                        </li>
                    </ul>
                </li>

                <li class="nav-item" data-toggle="tooltip" data-placement="right" title="Báo cáo thống kê">
                    <a class="nav-link nav-link-collapse collapsed" data-toggle="collapse" href="#collapseExamplePages1"
                        data-parent="#exampleAccordion">
                        <i class="fa fa-fw fa-bar-chart" style="font-size: 20px"></i>
                        <span class="nav-link-text" style="font-size: 18px">Báo cáo tổng hợp</span>
                    </a>
                    <ul class="sidenav-second-level collapse" id="collapseExamplePages1">
                        <li>
                            <a href='<%= ResolveUrl("BAO_CAO/BaoCaoTinhHinhSDDN.aspx")%>'>A. Báo cáo tình hình sử dụng</a>
                        </li>
                        <li>
                            <a href='<%= ResolveUrl("BAO_CAO/BangKeTienDien.aspx")%>'>B. Bảng kê tiền điện</a>
                        </li>
                        <li>
                            <a href='<%= ResolveUrl("BAO_CAO/BaoCaoDSKhachHang.aspx")%>'>C. Danh sách khách hàng theo các mục đích
                            </a>
                        </li>
                        <li>
                            <a href='<%= ResolveUrl("BAO_CAO/DSChotChiSo.aspx")%>'>D. Danh sách chốt chỉ số</a>
                        </li>
                        <li>
                            <a href='<%= ResolveUrl("BAO_CAO/DanhSachTieuThu.aspx")%>'>E. Danh sách tiêu thụ </a>
                        </li>
                        <li>
                            <a href='<%= ResolveUrl("BAO_CAO/BaoCaoQuanTri.aspx")%>'>F. Báo cáo quản trị</a>
                        </li>
                    </ul>
                </li>
                <li class="nav-item" data-toggle="tooltip" data-placement="right" title="Hướng dẫn sử dụng">
                    <a class="nav-link" href="<%= ResolveUrl("HDSD/VNPT_HDSD_VNPT-EMAN.pdf")%>" target="_blank">
                        <i class="fa fa-file-pdf-o" style="font-size: 20px"></i>
                        <span class="nav-link-text" style="font-size: 18px; margin-left: 4px">Hướng dẫn sử dụng</span>
                    </a>
